PORT="3001"
JWT_SECRET="generate a random secret, e.g. node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
MONGODB_URI="mongodb+srv://user:pass@your-cluster.mongodb.net/leetcode-tracker?appName=leetcode-tracker"

# Comma-separated. Include your deployed frontend's origin in production.
CORS_ORIGIN=http://localhost:5173

# Local dev default (docker-compose's Kafka) needs none of these. For a
# managed broker (Upstash Kafka, Confluent Cloud), set KAFKA_BROKER to the
# provider's broker URL and both of these to enable SASL_SSL — see
# backend/kafka/client.js.
# KAFKA_BROKER=
# KAFKA_USERNAME=
# KAFKA_PASSWORD=

# Local dev default is redis://localhost:6379. For Upstash Redis, this is
# its rediss:// connection string (ioredis auto-detects TLS from the
# scheme, no code change needed) — see backend/redis/client.js.
# REDIS_URL=

# Only needed for the single-Render-Web-Service deploy shape (render.yaml) —
# leave unset for docker-compose, where the two Kafka consumers run as their
# own containers instead. See the file-level comment in backend/app.js.
# ENABLE_INPROCESS_CONSUMERS=true

# Shared secret required by POST /api/admin/*, which an external scheduler
# (see .github/workflows/scheduled-tasks.yml) calls on a schedule in place
# of node-cron, since Render's free Web Service tier has no free always-on
# process to run node-cron in. Generate with the same command as
# JWT_SECRET above. Leave unset to disable these endpoints entirely (they
# 503 rather than running unauthenticated).
# ADMIN_TASK_TOKEN=
