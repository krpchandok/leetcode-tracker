# Same MongoDB Atlas (or local) connection string the Node backend uses.
# If it has no database name in the path (e.g. "mongodb+srv://user:pass@host/"),
# this pipeline resolves to the database "test", matching Mongoose's own
# default in that situation — see spark_session.get_database_name().
MONGODB_URI="mongodb://localhost:27017/leetcode-tracker"

# See AWS_SETUP.md for how to create the bucket and a least-privilege IAM
# user scoped to only s3:PutObject/s3:GetObject on it — never reuse
# broader account credentials here.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME=""
